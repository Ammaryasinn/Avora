  @@unique([organizationId, id])
  @@index([organizationId, configurationId, createdAt])
  @@index([snapshotHash])
}

model MetaPublishApproval {
  id              String    @id @default(cuid())
  organizationId  String
  campaignId      String
  configurationId String
  validationId    String
  approvedById    String
  snapshotHash    String
  approvedAt      DateTime  @default(now())
  revokedAt       DateTime?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  configuration CampaignMetaConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  validation   MetaCampaignValidation   @relation(fields: [validationId], references: [id], onDelete: Restrict)
  approvedBy   User                     @relation("MetaPublishApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  jobs         MetaPublishJob[]

  @@unique([organizationId, id])
  @@unique([organizationId, configurationId, snapshotHash])
  @@index([campaignId])
  @@index([approvedById])
}

model MetaPublishJob {
  id              String               @id @default(cuid())
  organizationId  String
  campaignId      String
  configurationId String
  approvalId      String
  initiatedById   String
  idempotencyKey  String
  snapshotHash    String
  snapshot        Json
  status          MetaPublishJobStatus @default(PENDING)
  attemptCount    Int                  @default(0)
  maxAttempts     Int                  @default(5)
  availableAt     DateTime             @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  leaseExpiresAt  DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  configuration CampaignMetaConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  approval     MetaPublishApproval      @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  initiatedBy  User                     @relation("MetaPublishInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  steps         MetaPublishStep[]
  campaignMappings MetaCampaignMapping[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([status, availableAt, leaseExpiresAt])
  @@index([organizationId, campaignId, createdAt])
}

model MetaPublishStep {
  id             String                @id @default(cuid())
  organizationId String
  jobId          String
  type           MetaPublishStepType
  localKey       String
  requestFingerprint String
  publicationMarker  String
  externalId     String?
