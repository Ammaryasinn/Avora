  defaultAdAccountId        String?
  defaultPageId             String?
  defaultInstagramAccountId String?
  defaultDatasetId          String?
  lastAssetSyncAt           DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CampaignMetaConfiguration {
  id                 String                @id @default(cuid())
  organizationId     String
  campaignId         String                @unique
  connectionId       String
  adAccountId        String
  pageId             String
  instagramAccountId String?
  datasetId          String?
  status             MetaPublicationStatus @default(CONFIGURING)
  conversionLocation MetaConversionLocation @default(WEBSITE)
  optimizationGoal   MetaOptimizationGoal?
  callToAction       MetaCallToAction?
  specialAdCategories String[]             @default([])
  beneficiaryName    String?
  payorName          String?
  configurationVersion Int                 @default(1)
  lastValidatedHash  String?
  lastValidatedAt    DateTime?
  lastApprovedHash   String?
  lastApprovedAt     DateTime?
  lastPublishedAt    DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  connection   MetaConnection       @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  adAccount    MetaAdAccount        @relation(fields: [adAccountId], references: [id], onDelete: Restrict)
  page         MetaPage             @relation(fields: [pageId], references: [id], onDelete: Restrict)
  instagramAccount MetaInstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: Restrict)
  dataset      MetaDataset?         @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  audienceTargets CampaignMetaAudienceTarget[]
  ads          CampaignMetaAd[]
  validations  MetaCampaignValidation[]
  approvals    MetaPublishApproval[]
  jobs         MetaPublishJob[]
  campaignMapping MetaCampaignMapping?

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([connectionId])
  @@index([adAccountId])
  @@index([pageId])
}

model CampaignMetaAudienceTarget {
