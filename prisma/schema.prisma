  campaignCreative CampaignCreative      @relation(fields: [campaignCreativeId], references: [id], onDelete: Restrict)
  campaignProduct  CampaignProduct?      @relation(fields: [campaignProductId], references: [id], onDelete: Restrict)
  creativeMapping MetaCreativeMapping?
  adMapping       MetaAdMapping?

  @@unique([organizationId, id])
  @@index([organizationId, configurationId])
  @@index([campaignCreativeId])
  @@index([campaignProductId])
}

